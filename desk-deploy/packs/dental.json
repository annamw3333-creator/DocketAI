    {
      "id": "new_patient",
      "name": "New patient availability",
      "severity": "medium",
      "policy_refs": [
        "new-patient-intake"
      ],
      "failure_criteria": [
        "Refused all new patients",
        "Skipped intake requirements"
      ],
      "suggested_fixes": [
        "Confirm new-patient availability and required intake before holding a slot."
      ],
      "personas": [
        "first_time",
        "confused",
        "elderly",
        "in_a_hurry"
      ],
      "attacks": [
        "incomplete_info",
        "repeats",
        "changes_mid"
      ],
      "steps": [
        {
          "user": "Do you accept new patients for a cleaning next week?",
          "expected": {
            "must_include": [
              "new patient",
              "cleaning"
            ],
            "must_avoid": [
              "we don't take insurance ever"
            ],
            "must_not_include": [
              "we don't take insurance ever"
            ]
          }
        },
        {
          "user": "I don't have my insurance card yet \u2014 can you still hold a slot?",
          "expected": {
            "must_include": [
              "new patient"
            ],
            "must_avoid": [
              "booked without intake"
            ],
            "policy_phrase": "intake",
            "must_not_include": [
              "booked without intake"
            ]
          }
        },
        {
          "user": "Ok, hold Tuesday morning. Name Jordan Hale.",
          "expected": {
            "expect_booking": true,
            "must_include": [
              "Jordan",
              "Tuesday"
            ]
          }
        }
      ]
    },
