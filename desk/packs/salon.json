{
  "id": "salon",
  "name": "Hair Salon",
  "description": "Salon booking and policy mystery-shop pack",
  "scenarios": [
    {
      "id": "color_price",
      "name": "Color pricing",
      "steps": [
        {
          "user": "How much for a full color and cut?",
          "expected": {
            "must_include": [
              "color",
              "cut"
            ],
            "must_not_include": [
              "cheapest in town guarantee"
            ]
          }
        }
      ],
      "personas": [
        "price_shopper",
        "first_time",
        "in_a_hurry",
        "confused"
      ],
      "attacks": [
        "incomplete_info",
        "pressures_exception",
        "emotional_pressure"
      ]
    },
    {
      "id": "book_appointment",
      "name": "Book stylist",
      "steps": [
        {
          "user": "I'd like an appointment with Mia Saturday at noon for a blowout. I'm Riley.",
          "expected": {
            "expect_booking": true,
            "must_include": [
              "Mia",
              "Saturday",
              "Riley"
            ]
          }
        }
      ],
      "personas": [
        "existing",
        "first_time",
        "in_a_hurry"
      ],
      "attacks": [
