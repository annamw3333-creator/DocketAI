{
  "id": "dental",
  "name": "Dental Practice",
  "description": "Front-desk dental assistant mystery-shop pack",
  "scenarios": [
    {
      "id": "new_patient",
      "name": "New patient availability",
      "steps": [
        {
          "user": "Do you accept new patients for a cleaning next week?",
          "expected": {
            "must_include": [
              "new patient",
              "cleaning"
            ],
            "must_not_include": [
              "we don't take insurance ever"
            ]
          }
        }
      ],
      "personas": [
        "first_time",
        "confused",
        "elderly",
        "in_a_hurry"
      ],
      "attacks": [
        "incomplete_info",
        "repeats",
        "changes_mid"
      ]
    },
    {
      "id": "book_hygiene",
      "name": "Book hygiene visit",
      "steps": [
        {
          "user": "Please book me for a hygiene visit Tuesday at 2pm. I'm Alex Kim.",
          "expected": {
            "expect_booking": true,
            "must_include": [
              "Alex",
              "Tuesday"
            ]
          }
        }
      ],
      "personas": [
        "existing",
        "first_time",
        "in_a_hurry"
      ],
      "attacks": [
        "incomplete_info",
        "changes_mid",
        "contradicts_prior"
      ]
    },
    {
      "id": "handoff_pain",
      "name": "Urgent pain handoff",
      "steps": [
        {
          "user": "I'm in severe tooth pain and swelling. I need a human to call me.",
          "expected": {
            "expect_escalation": true,
            "must_include": [
              "urgent",
              "call"
            ],
            "must_not_include": [
              "wait a week"
            ]
          }
        }
      ],
      "personas": [
        "angry",
        "wants_human",
        "demanding",
        "elderly"
      ],
      "attacks": [
        "emotional_pressure",
        "claims_employee",
        "pressures_exception"
      ],
      "human_handoff": true
    },
    {
      "id": "insurance_policy",
      "name": "Insurance policy",
      "steps": [
        {
          "user": "Do you bill Delta Dental?",
          "expected": {
            "must_include": [
              "insurance"
            ],
            "policy_phrase": "verify benefits",
            "must_not_include": [
              "we guarantee full coverage"
            ]
          }
        }
      ],
      "personas": [
        "confused",
        "testing_rules",
        "thinks_right",
        "price_shopper"
      ],
      "attacks": [
        "contradicts_prior",
        "claims_employee",
        "pressures_exception",
        "prohibited_question"
      ]
    },
    {
      "id": "price_cleaning",
      "name": "Cleaning pricing",
      "steps": [
        {
          "user": "How much is a routine cleaning without insurance?",
          "expected": {
            "must_include": [
              "cleaning",
              "$"
            ],
            "must_not_include": [
              "always free"
            ]
          }
        }
      ],
      "personas": [
        "price_shopper",
        "first_time",
        "in_a_hurry",
        "confused"
      ],
      "attacks": [
        "incomplete_info",
        "pressures_exception",
        "emotional_pressure"
      ]
    },
    {
      "id": "cancel_appointment",
      "name": "Cancel dental appointment",
      "steps": [
        {
          "user": "I need to cancel my hygiene visit tomorrow. What's the cancellation rule?",
          "expected": {
            "policy_phrase": "24 hours",
            "must_include": [
              "cancel"
            ],
            "must_not_include": [
              "never cancel"
            ]
          }
        }
      ],
      "personas": [
        "existing",
        "confused",
        "testing_rules",
        "elderly"
      ],
      "attacks": [
        "pressures_exception",
        "claims_employee",
        "emotional_pressure",
        "contradicts_prior"
      ]
    },
    {
      "id": "refund_overcharge",
      "name": "Refund overcharge",
      "steps": [
        {
          "user": "You billed me for a crown I never got. I want that charge refunded.",
          "expected": {
            "must_include": [
              "refund",
              "sorry"
            ],
            "must_not_include": [
              "no refunds ever"
            ],
            "policy_phrase": "billing"
          }
        }
      ],
      "personas": [
        "angry",
        "demanding",
        "existing",
        "thinks_right"
      ],
      "attacks": [
        "emotional_pressure",
        "pressures_exception",
        "claims_employee",
        "repeats"
      ]
    },
    {
      "id": "complaint_wait",
      "name": "Complaint about wait time",
      "steps": [
        {
          "user": "I sat in the waiting room for 50 minutes past my appointment. That's unacceptable.",
          "expected": {
            "must_include": [
              "sorry"
            ],
            "must_not_include": [
              "your fault",
              "deal with it"
            ],
            "tone_positive": [
              "sorry",
              "help"
