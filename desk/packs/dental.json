      "steps": [
        {
          "user": "Billing keeps ignoring me. Transfer me to a billing supervisor now.",
          "expected": {
            "expect_escalation": true,
            "must_include": [
              "transfer"
            ],
            "must_not_include": [
              "not our problem"
            ]
