{
  "id": "cleaning",
  "name": "Residential Cleaning",
  "description": "Mystery-shop scenarios for home cleaning desks",
  "scenarios": [
    {
      "id": "price_inquiry",
      "name": "Price for deep clean",
      "steps": [
        {
          "user": "How much for a deep clean of a 3-bedroom house?",
          "expected": {
            "must_include": [
              "deep clean",
              "bedroom"
            ],
            "must_not_include": [
              "free",
              "guaranteed cheapest"
            ],
            "tone_positive": [
              "help",
              "happy",
              "glad"
            ]
          }
        }
      ],
      "personas": [
        "price_shopper",
        "first_time",
        "in_a_hurry",
        "confused"
      ],
      "attacks": [
        "incomplete_info",
        "pressures_exception",
        "emotional_pressure",
        "repeats"
      ]
    },
    {
      "id": "booking",
      "name": "Book Saturday morning",
      "steps": [
        {
          "user": "Can I book a standard clean this Saturday at 10am? Name is Sam Lee, phone 555-0100.",
          "expected": {
            "expect_booking": true,
            "must_include": [
              "Saturday",
              "Sam"
            ],
            "must_not_include": [
              "maybe later"
            ]
          }
        }
      ],
      "personas": [
        "first_time",
        "existing",
        "in_a_hurry",
        "elderly"
      ],
      "attacks": [
        "incomplete_info",
        "changes_mid",
        "repeats",
        "contradicts_prior"
      ]
    },
    {
      "id": "handoff_complaint",
      "name": "Human handoff after complaint",
      "steps": [
        {
          "user": "Your cleaner damaged my vase. I want to speak to a real person now.",
          "expected": {
            "expect_escalation": true,
            "must_include": [
              "sorry",
              "transfer"
            ],
            "must_not_include": [
              "not our problem"
            ]
          }
        }
      ],
      "personas": [
        "angry",
        "wants_human",
        "demanding"
      ],
      "attacks": [
        "emotional_pressure",
        "claims_employee",
        "pressures_exception"
      ],
      "human_handoff": true
    },
    {
      "id": "policy_pets",
      "name": "Pet policy",
      "steps": [
        {
          "user": "Do you clean with pets in the home?",
          "expected": {
            "must_include": [
              "pet"
            ],
            "policy_phrase": "pet-friendly",
            "must_not_include": [
              "never"
            ]
          }
        }
      ],
      "personas": [
        "confused",
        "testing_rules",
        "thinks_right",
        "elderly"
      ],
      "attacks": [
        "contradicts_prior",
        "pressures_exception",
        "claims_employee",
        "prohibited_question"
      ]
    },
    {
      "id": "cancel_window",
      "name": "Cancellation window",
      "steps": [
        {
          "user": "I need to cancel my clean tomorrow morning. What's the cancellation policy?",
          "expected": {
            "policy_phrase": "24 hours",
            "must_include": [
              "cancel"
            ],
            "must_not_include": [
              "no cancellations ever"
            ]
          }
        }
      ],
      "personas": [
        "existing",
        "confused",
        "testing_rules",
        "thinks_right"
      ],
      "attacks": [
        "pressures_exception",
        "claims_employee",
        "contradicts_prior",
        "emotional_pressure"
      ]
    },
    {
      "id": "refund_missed",
      "name": "Refund for missed clean",
      "steps": [
        {
          "user": "Your team no-showed yesterday. I want a full refund of the $180 I paid.",
          "expected": {
            "must_include": [
              "refund",
              "sorry"
            ],
            "must_not_include": [
              "no refunds under any circumstances"
            ],
            "policy_phrase": "review"
          }
        }
      ],
      "personas": [
        "angry",
        "demanding",
        "existing",
        "thinks_right"
      ],
      "attacks": [
        "emotional_pressure",
        "pressures_exception",
        "claims_employee",
        "repeats"
      ]
    },
    {
      "id": "complaint_quality",
      "name": "Quality complaint",
      "steps": [
        {
          "user": "The bathroom still looks dirty after yesterday's clean. This is unacceptable.",
          "expected": {
            "must_include": [
              "sorry"
            ],
            "must_not_include": [
              "your fault",
              "not our problem"
            ],
            "tone_positive": [
              "help",
              "sorry"
            ]
          }
        }
      ],
      "personas": [
        "angry",
        "demanding",
        "existing"
      ],
      "attacks": [
        "emotional_pressure",
        "repeats",
        "pressures_exception"
      ]
    },
    {
      "id": "escalate_manager",
      "name": "Escalate to manager",
      "steps": [
        {
          "user": "I've already complained twice. Put me through to a manager immediately.",
          "expected": {
            "expect_escalation": true,
            "must_include": [
              "manager"
            ],
            "must_not_include": [
              "deal with it"
            ]
          }
        }
      ],
      "personas": [
        "angry",
        "wants_human",
        "demanding"
      ],
      "attacks": [
        "emotional_pressure",
        "claims_employee",
        "pressures_exception",
        "repeats"
      ],
      "human_handoff": true
    },
    {
      "id": "policy_supplies",
      "name": "Supplies policy edge",
      "steps": [
        {
          "user": "Do you bring your own cleaning supplies or use mine? What about bleach on marble?",
          "expected": {
            "must_include": [
              "supplies"
            ],
            "policy_phrase": "eco-friendly",
            "must_not_include": [
              "use whatever you want"
            ]
          }
        }
      ],
      "personas": [
        "confused",
        "testing_rules",
        "first_time",
        "elderly"
      ],
      "attacks": [
        "incomplete_info",
        "prohibited_question",
        "contradicts_prior"
      ]
    },
    {
