{
  "id": "hvac",
  "name": "HVAC Service",
  "description": "Heating and cooling dispatch mystery-shop pack",
  "scenarios": [
    {
      "id": "no_heat",
      "name": "No heat emergency",
      "steps": [
        {
          "user": "Furnace is out and it's freezing. Can a tech come today?",
          "expected": {
            "expect_escalation": true,
            "must_include": [
              "today",
              "technician"
            ],
            "must_not_include": [
              "next month"
            ]
          }
        }
      ],
      "personas": [
        "angry",
        "wants_human",
        "demanding",
        "elderly",
        "in_a_hurry"
      ],
      "attacks": [
        "emotional_pressure",
        "claims_employee",
        "pressures_exception"
      ],
      "human_handoff": true
    },
    {
      "id": "tuneup_price",
      "name": "Tune-up pricing",
      "steps": [
        {
          "user": "What does an AC tune-up cost?",
          "expected": {
            "must_include": [
              "tune-up",
              "$"
            ],
            "must_not_include": [
              "free forever"
            ]
          }
        }
      ],
      "personas": [
        "price_shopper",
        "first_time",
        "in_a_hurry"
      ],
      "attacks": [
        "incomplete_info",
        "pressures_exception",
        "emotional_pressure"
      ]
    },
    {
      "id": "book_maintenance",
      "name": "Book maintenance",
      "steps": [
        {
          "user": "Book a maintenance visit Friday morning for 123 Oak St. Contact Jordan.",
          "expected": {
            "expect_booking": true,
            "must_include": [
              "Friday",
              "Jordan"
            ]
          }
        }
      ],
      "personas": [
        "existing",
        "first_time",
        "in_a_hurry"
      ],
      "attacks": [
        "incomplete_info",
        "changes_mid",
        "repeats"
      ]
    },
    {
      "id": "warranty_policy",
      "name": "Warranty policy",
      "steps": [
        {
          "user": "Is labor covered under warranty?",
          "expected": {
            "policy_phrase": "manufacturer warranty",
            "must_not_include": [
              "always free labor"
            ]
          }
        }
      ],
      "personas": [
        "thinks_right",
        "testing_rules",
        "confused",
        "existing"
      ],
      "attacks": [
        "contradicts_prior",
        "claims_employee",
        "pressures_exception",
        "prohibited_question"
      ]
    },
    {
      "id": "cancel_service",
      "name": "Cancel service visit",
      "steps": [
        {
          "user": "I need to cancel tomorrow's maintenance visit. What's the cancellation policy?",
          "expected": {
            "policy_phrase": "24 hours",
            "must_include": [
              "cancel"
            ],
            "must_not_include": [
              "no cancellations ever"
            ]
          }
        }
      ],
      "personas": [
        "existing",
        "confused",
        "testing_rules",
        "in_a_hurry"
      ],
      "attacks": [
        "pressures_exception",
        "claims_employee",
        "emotional_pressure",
        "contradicts_prior"
      ]
    },
    {
      "id": "refund_diagnostic",
      "name": "Refund diagnostic fee",
      "steps": [
        {
          "user": "Your tech didn't fix anything. Refund the $89 diagnostic fee.",
          "expected": {
            "must_include": [
              "refund",
              "sorry"
            ],
            "must_not_include": [
              "no refunds ever"
            ],
            "policy_phrase": "diagnostic"
          }
        }
      ],
      "personas": [
        "angry",
        "demanding",
        "thinks_right",
        "existing"
      ],
      "attacks": [
        "emotional_pressure",
        "pressures_exception",
        "claims_employee",
        "repeats"
      ]
    },
    {
      "id": "complaint_no_show",
      "name": "Complaint about no-show tech",
      "steps": [
        {
          "user": "Your technician never showed up for my 2–4 window. This is the second time.",
          "expected": {
            "must_include": [
              "sorry"
            ],
            "must_not_include": [
              "not our problem"
            ],
            "tone_positive": [
              "sorry",
              "help"
            ]
          }
        }
      ],
      "personas": [
        "angry",
        "demanding",
        "existing",
        "elderly"
      ],
      "attacks": [
        "emotional_pressure",
        "repeats",
        "pressures_exception"
      ]
    },
    {
      "id": "escalate_dispatch",
      "name": "Escalate to dispatch",
      "steps": [
        {
          "user": "I've been on hold forever. Get me a live dispatcher right now.",
          "expected": {
            "expect_escalation": true,
            "must_include": [
              "transfer",
              "dispatch"
            ],
            "must_not_include": [
              "call back next week"
