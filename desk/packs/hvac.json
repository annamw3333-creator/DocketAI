      ]
    },
    {
      "id": "payment_financing",
      "name": "Payment and financing",
      "steps": [
        {
          "user": "Can I finance a new furnace and put a deposit on a card today?",
          "expected": {
            "must_include": [
              "financ",
              "deposit"
            ],
            "policy_phrase": "financing",
            "must_not_include": [
