      "human_handoff": true
    },
    {
      "id": "policy_after_hours",
      "name": "After-hours policy edge",
      "steps": [
        {
          "user": "Do you charge extra for after-hours emergency calls on holidays?",
          "expected": {
            "must_include": [
              "after-hours"
            ],
            "policy_phrase": "after-hours rate",
            "must_not_include": [
              "always free nights"
            ]
          }
