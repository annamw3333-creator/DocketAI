# Docket Desk companion API
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
DATABASE_PATH=./data/desk.db
# Public base URL used in shareable report links
PUBLIC_BASE_URL=http://localhost:8000
# Alert when any score dimension drops below this (0-100)
ALERT_SCORE_THRESHOLD=70
# HTTPS Slack/Teams webhook (optional)
ALERT_WEBHOOK_URL=
# Email for score-drop alerts (optional; logs if SMTP unset)
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=docket-desk@localhost
# Comma-separated origins for CORS (WP site + local)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
