{
  "expo": {
    "name": "DocketAI",
    "slug": "docketai",
    "version": "1.2.1",
    "description": "DocketAI \u2014 mystery-shop QA for customer-service chatbots.",
    "primaryColor": "#000000",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "docketai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.docketai.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.docketai.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
